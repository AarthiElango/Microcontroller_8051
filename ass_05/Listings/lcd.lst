MACRO ASSEMBLER A51 V8.2.7.0
OBJECT MODULE PLACED IN .\Objects\lcd.obj
ASSEMBLER INVOKED BY: C:\Keil_v5\C51\BIN\A51.EXE lcd.a51 SET(SMALL) DEBUG PRINT(.\Listings\lcd.lst) OBJECT(.\Objects\lcd
                      .obj) EP

LOC  OBJ            LINE     SOURCE

0000                   1     ORG 0000H
                       2     
0000 75A000            3     MOV P2, #00H    ; Configure P2 as output (LCD data)
0003 75B000            4     MOV P3, #00H    ; Configure P3 as output (Control pins)
                       5     
0006 110F              6     CALL INIT_LCD   ; Initialize LCD
                       7     
                       8     ; Display "Hi! Welcome"
0008 900058            9     MOV DPTR, #MSG  ; Load message address
000B 113E             10     CALL DISPLAY_STR
                      11     
000D 80FE             12     HERE: SJMP HERE ; Infinite loop
                      13     
                      14     ; ---------- LCD Initialization -------------
000F                  15     INIT_LCD:
000F 7438             16         MOV A, #38H  ; Function Set: 8-bit mode, 2 lines, 5x8 font
0011 1120             17         CALL CMD_WR
0013 740E             18         MOV A, #0EH  ; Display ON, Cursor OFF
0015 1120             19         CALL CMD_WR
0017 7401             20         MOV A, #01H  ; Clear Display
0019 1120             21         CALL CMD_WR
001B 7406             22         MOV A, #06H  ; Entry Mode: Auto Increment
001D 1120             23         CALL CMD_WR
                      24             
                      25             
001F 22               26         RET
                      27     
                      28     ; ---------- Command Write Function -------------
0020                  29     CMD_WR:
0020 F5A0             30         MOV P2, A    ; Send command to LCD
0022 C2B0             31         CLR P3.0     ; RS = 0 (Command mode)
0024 C2B1             32         CLR P3.1     ; RW = 0 (Write)
0026 D2B2             33         SETB P3.2    ; Enable high
0028 114F             34         ACALL DELAY
002A C2B2             35         CLR P3.2     ; Enable low
002C 114F             36         ACALL DELAY
002E 22               37         RET
                      38     
                      39     ; ---------- Data Write Function -------------
002F                  40     DATA_WR:
002F F5A0             41         MOV P2, A    ; Send data to LCD
0031 D2B0             42         SETB P3.0    ; RS = 1 (Data mode)
0033 C2B1             43         CLR P3.1     ; RW = 0 (Write)
0035 D2B2             44         SETB P3.2    ; Enable high
0037 114F             45         ACALL DELAY
0039 C2B2             46         CLR P3.2     ; Enable low
003B 114F             47         ACALL DELAY
003D 22               48         RET
                      49     
                      50     ; ---------- Display String Function -------------
003E                  51     DISPLAY_STR:
003E E4               52         CLR A
003F 93               53         MOVC A, @A+DPTR ; Load first character
0040 6005             54         JZ L_SCROLL     ; If null terminator, exit
0042 112F             55         CALL DATA_WR    ; Send character to LCD
0044 A3               56         INC DPTR        ; Move to next character
0045 80F7             57         SJMP DISPLAY_STR
A51 MACRO ASSEMBLER  LCD                                                                  04/18/2025 22:35:29 PAGE     2

                      58             
0047                  59             L_SCROLL:
0047 7418             60             MOV A,#18H;     shift ,display shift,left 
0049 1120             61             ACALL CMD_WR 
004B 114F             62              ACALL DELAY 
004D 80F8             63             SJMP L_SCROLL   
                      64     
                      65     
                      66     ; ---------- Delay Function -------------
004F                  67     DELAY:
004F 7FFF             68         MOV R7, #255
0051                  69     DELAY_LOOP1:
0051 7EFF             70         MOV R6, #255
0053                  71     DELAY_LOOP2:
0053 DEFE             72         DJNZ R6, DELAY_LOOP2
0055 DFFA             73         DJNZ R7, DELAY_LOOP1
0057 22               74         RET
                      75     
                      76     ; ---------- Message Data -------------
0058 48656C6C         77     MSG: DB "Hellooo", 0  ; String with null terminator
005C 6F6F6F00                
                      78     
                      79     END
